# ---------------------------------------------------------------------------
# Public Records Research MVP - example environment configuration
# Copy to .env and adjust. NEVER commit a real .env with secrets.
# ---------------------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=replace-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Postgres (used by docker compose). For local non-docker dev you may point at
# a local Postgres or leave the sqlite fallback used by the test-suite.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/public_records

# Redis / background worker
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# OpenAI (optional). When empty the app runs in deterministic mode.
# OPENAI_BASE_URL lets you target any OpenAI-compatible server (self-hosted /
# custom-OpenAI endpoint). Leave empty for the official OpenAI API.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Uploads / processing
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=/data/uploads
OCR_ENABLED=true

# CORS (comma separated). Use * only for local development.
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
